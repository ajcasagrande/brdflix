<!DOCTYPE html>
#import brdflix
#from brdflix import xbmc
<html>
<head>
<title>BRDFlix</title>
#include $os.path.join($brdflix.TMPL_DIR, "global_css.tmpl")

#include $os.path.join($brdflix.TMPL_DIR, "global_js.tmpl")
</head>
<body>
#include $os.path.join($brdflix.TMPL_DIR, "header.tmpl")

<h2>Favorite Shows:</h2>
<table>
#for $fave in $favorite_shows:
    <tr><td>
    #set $ep = xbmc.getNextEpisode($fave.xbmc_id)
    <a href="/tv/seasons?idShow=$fave.xbmc_id">$fave.show_name</a>
    <br />
    #if $ep is not None:
        #set $epName = ($ep.epName).replace('&', '%26')
        #set $watched = $ep.watched
        #set $num = "{0}x{1:02}".format($ep.season, $ep.episode)
        <div class="episodeThumb" title="$ep.summary">
            <a style="text-decoration:none" href="/watch/episode?id=$ep.id">
            <img style="background-color: black;" src="/img/episodeThumb?season=$ep.season&episode=$ep.episode&watched=$watched&thumbpath64=$ep.thumbpath64" width="200" height="112" />
            <div class="episodeName">$num - $ep.epName</div></a>
        </div>
    #end if
    </td></tr>
#end for
</table>

#include $os.path.join($brdflix.TMPL_DIR, "footer.tmpl")
</body>
</html>
